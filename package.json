{
  "name": "@chbrain/khai-phoenix",
  "version": "0.4.0",
  "description": "khai: the Phoenix, a bestiary of fire. Entities staged with khai, each grounded in the fire and combustion engines.",
  "type": "module",
  "exports": {
    ".": "./package.json",
    "./package.json": "./package.json",
    "./registry.json": "./registry.json"
  },
  "license": "SEE LICENSE IN LICENSE and LICENSE-CODE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChBrain/khai-phoenix.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "bestiary/**",
    "registry.json",
    "README.md",
    "LICENSE",
    "LICENSE-CODE"
  ],
  "khai": {
    "engine": "phoenix",
    "card": {
      "wire": "The Phoenix: a bestiary of fire, each entity a named phenomenon of combustion given a first-person voice."
    },
    "collection": {
      "dir": "bestiary",
      "key": "bestiary",
      "anchor": "play_"
    }
  },
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version": "changeset version && khai-tests registry build",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@chbrain/khai-arch": "^0.1.0",
    "@chbrain/khai-language": "^0.1.0",
    "@chbrain/khai-tests": "^0.1.0",
    "@chbrain/khai-guard": "^0.1.0",
    "@chbrain/khai-review": "^0.1.0",
    "@chbrain/khai-pack": "^0.0.3",
    "vitest": "^4.1.8",
    "prettier": "^3.3.0",
    "husky": "^9.1.0"
  },
  "dependencies": {
    "@chbrain/khai-engine-fire": "^0.1.0",
    "@chbrain/khai-engine-combustion": "^0.1.0",
    "@chbrain/khai-composite-blaze": "^0.1.0"
  }
}
